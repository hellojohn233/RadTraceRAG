# RadTraceRAG 配置样例
#
# 复制成 .env 后按需填写。**不要把 .env 提交进仓库**（.gitignore 已经挡了）。
#
#   cp .env.example .env
#
# 真实凭据只走环境变量，不进代码、不进数据库。

# ---------------------------------------------------------------- 向量库：Milvus
#
# 向量检索交给 LightRAG 的 Milvus 存储实现，B（向量）和 C（图增强）两组
# 共用同一份底座——底座不同，测出来的「图增强增量」就不成立。
# 官方 lightrag-server 用的是同一套变量名，可以指到同一个 Milvus。
#
# 本地 Milvus Lite（开发用）：
MILVUS_URI=./rag_storage/milvus_lite.db
# 独立部署的 Milvus：
# MILVUS_URI=http://127.0.0.1:19530
# MILVUS_USER=
# MILVUS_PASSWORD=
# MILVUS_TOKEN=
MILVUS_DB_NAME=radtracerag
MILVUS_INDEX_TYPE=AUTOINDEX
MILVUS_METRIC_TYPE=COSINE

# ---------------------------------------------------------------- 存储后端
#
# 其余存储用 LightRAG 自带的本地实现。图也用 LightRAG 的，不另建图。
RADTRACERAG_WORKSPACE=radtracerag
RADTRACERAG_VECTOR_STORAGE=MilvusVectorDBStorage
RADTRACERAG_KV_STORAGE=JsonKVStorage
RADTRACERAG_GRAPH_STORAGE=NetworkXStorage
RADTRACERAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
# RADTRACERAG_DATA_DIR=./data
# RADTRACERAG_STORAGE_DIR=./rag_storage

# ---------------------------------------------------------------- 模型服务
#
# 统一走 OpenAI 兼容接口：本地 vLLM / Ollama / LM Studio，或云上的兼容服务。
# 视觉模型看片，文本模型答题，嵌入模型建向量——三者可以指到不同服务。
#
# 关键：嵌入维度必须和 Milvus 集合一致，建集合时用的就是这个值。
RADTRACERAG_LLM_BASE_URL=http://127.0.0.1:8001/v1
RADTRACERAG_LLM_API_KEY=EMPTY
RADTRACERAG_LLM_MODEL=qwen2.5-7b-instruct

RADTRACERAG_VLM_BASE_URL=http://127.0.0.1:8002/v1
RADTRACERAG_VLM_API_KEY=EMPTY
RADTRACERAG_VLM_MODEL=qwen2.5-vl-7b-instruct

RADTRACERAG_EMBEDDING_BASE_URL=http://127.0.0.1:8003/v1
RADTRACERAG_EMBEDDING_API_KEY=EMPTY
RADTRACERAG_EMBEDDING_MODEL=bge-m3
RADTRACERAG_EMBEDDING_DIM=1024

# ---------------------------------------------------------------- API
#
# 允许哪些前端跨域访问，逗号分隔。开发时填 React dev server 的地址。
RADTRACERAG_CORS_ORIGINS=http://localhost:5173
